# Copy this file to .env and fill in your secrets.

# --- LLM PROVIDER (alege unul; Anthropic Claude e preferat) ---

# Anthropic Claude (Recommended)
# Cheia ta de pe https://console.anthropic.com/settings/keys (incepe cu sk-ant-)
ANTHROPIC_API_KEY=sk-ant-your_key_here
# (Optional) Schimba modelul. Default: claude-sonnet-4-5-20250929
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# HuggingFace Inference API (fallback, optional)
# Token de pe https://huggingface.co/settings/tokens (cu permisiunea "Read")
# HUGGINGFACEHUB_API_TOKEN=hf_your_token_here
# HF_LLM_REPO_ID=mistralai/Mistral-7B-Instruct-v0.3

# --- DATELE ---

# Calea absoluta catre vault-ul Obsidian cu profilurile de candidati.
# Indexeaza recursiv candidates/**/Nume.md (exclude /attachments).
OBSIDIAN_VAULT_PATH=C:/Users/User/Desktop/buildathlon/OBSIDIAN-DATA-POOL

# (Optional) Unde sa persistam embeddings-urile ChromaDB. Default = ./chroma_storage.
# CHROMA_DB_PATH=./chroma_storage
