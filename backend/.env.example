# Copy this file to .env and fill in your secrets.

# Token-ul tau de pe https://huggingface.co/settings/tokens
# Trebuie sa fie un token cu permisiunea "Read" (sau "Inference API").
HUGGINGFACEHUB_API_TOKEN=hf_your_token_here

# (Optional) Override the LLM repo. Mistral-7B-Instruct-v0.3 e disponibil pe serverless inference;
# Mixtral-8x7B-Instruct-v0.1 NU mai este (dedicated endpoint required).
HF_LLM_REPO_ID=mistralai/Mistral-7B-Instruct-v0.3

# Calea absoluta catre vault-ul Obsidian cu profilurile de candidati.
# ObsidianLoader citeste recursiv toate fisierele .md.
OBSIDIAN_VAULT_PATH=C:/Users/User/Desktop/buildathlon/OBSIDIAN-DATA-POOL

# (Optional) Unde sa persistam embeddings-urile ChromaDB. Default = ./chroma_storage relativ la backend/.
# CHROMA_DB_PATH=./chroma_storage
