# =============================================================================
# CVision / TalentAI — environment configuration template
# Copy this file to `.env` and fill in the values you need.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM provider — chooses which chat model the backend uses for extraction,
# matching, merging, outreach drafts, and LinkedIn sourcing strategies.
#
#   groq    → Groq Cloud (US-hosted, fast, requires GROQ_API_KEY).
#             ⚠️ Sends candidate text to the US — review GDPR posture first.
#   mistral → Mistral La Plateforme (EU-hosted, GDPR-friendly).
#             Requires MISTRAL_API_KEY and `pip install langchain-mistralai`.
#   ollama  → Local Ollama daemon (fully on-prem, no external transmission).
#             Requires Ollama running locally — see https://ollama.com
# -----------------------------------------------------------------------------
LLM_PROVIDER=groq

# Groq credentials (only if LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Mistral credentials (only if LLM_PROVIDER=mistral)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Ollama configuration (only if LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# -----------------------------------------------------------------------------
# Data paths — override only if you keep the CSV / audit log somewhere unusual.
# Both default to backend/data/ alongside the source.
# -----------------------------------------------------------------------------
# CSV_PATH=backend/data/talent_pool.csv
# AUDIT_LOG_PATH=backend/data/audit.jsonl
